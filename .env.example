# NOMBRES DE VARIABLES ÚNICAMENTE; NO COLOQUES CREDENCIALES REALES EN ESTE ARCHIVO.
# NOTA: el aplicativo lee st.secrets, no carga .env automáticamente.
# Configura los valores reales en .streamlit/secrets.toml (local) o en Secrets
# de Streamlit Community Cloud. Las cuentas de prueba van en [users] como hashes.
NVIDIA_API_KEY=
GOOGLE_API_KEY=
NVIDIA_MODEL=
GEMINI_MODEL=
NVIDIA_VERIFIER_MODEL=
EMBEDDING_MODEL=
